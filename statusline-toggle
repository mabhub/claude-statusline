#!/usr/bin/env bash
# statusline-toggle — bascule le mode d'affichage de la status line Claude Code.
#
# Modes :
#   off    status line masquée (clé statusLine supprimée -> 0 ligne, garanti)
#   min    1 ligne : juste le % de contexte            (statusline-min.sh)
#   full   1 ligne : infos complètes et jauges          (statusline.sh)
#   auto   adaptatif : masqué si écran < seuil, sinon full (statusline-auto.sh)
#
# Usage :
#   statusline-toggle             # cycle off -> min -> full -> auto -> off
#   statusline-toggle off|min|full|auto
#   statusline-toggle status      # affiche le mode courant
#
# La prise d'effet est immédiate au prochain rafraîchissement de la status line
# (nouveau message / redraw, ou refreshInterval). Pour le mode auto, le seuil de
# hauteur se règle via CLAUDE_STATUSLINE_MIN_LINES (défaut 15) dans
# l'environnement de Claude Code.
#
# Les autres réglages de .statusLine (refreshInterval, padding…) sont conservés
# d'un mode à l'autre ; refreshInterval vaut REFRESH_S s'il n'est pas défini
# (au retour du mode off notamment, qui supprime toute la clé).

set -euo pipefail

DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
SETTINGS="$DIR/settings.json"
REFRESH_S=5  # relance périodique du script, en secondes (minimum Claude Code : 1)

[[ -f "$SETTINGS" ]] || { echo "Introuvable : $SETTINGS" >&2; exit 1; }
command -v jq >/dev/null || { echo "jq requis mais introuvable" >&2; exit 1; }

# --- Déduire le mode courant depuis settings.json ---
current_command="$(jq -r '.statusLine.command // ""' "$SETTINGS")"
case "$current_command" in
    "")                       current_mode="off"  ;;
    *statusline-min.sh)       current_mode="min"  ;;
    *statusline-auto.sh)      current_mode="auto" ;;
    *statusline.sh)           current_mode="full" ;;
    *)                        current_mode="custom" ;;   # commande non gérée par ce toggle
esac

# --- Sous-commande status ---
if [[ "${1:-}" == "status" ]]; then
    if [[ "$current_mode" == "custom" ]]; then
        echo "Mode actuel : custom -> $current_command"
    else
        echo "Mode actuel : $current_mode"
    fi
    exit 0
fi

# --- Déterminer le mode cible ---
order=(off min full auto)
if [[ $# -ge 1 ]]; then
    target="$1"
    case "$target" in off|min|full|auto) ;; *)
        echo "Mode inconnu : '$target' (attendu : off | min | full | auto | status)" >&2
        exit 2 ;;
    esac
else
    # Pas d'argument -> cycle vers le mode suivant.
    case "$current_mode" in
        off)  target="min"  ;;
        min)  target="full" ;;
        full) target="auto" ;;
        auto) target="off"  ;;
        *)    target="off"  ;;   # depuis un état custom, on repart proprement sur off
    esac
fi

# --- Script associé au mode ---
case "$target" in
    off)  script="" ;;
    min)  script="$DIR/statusline-min.sh"  ;;
    full) script="$DIR/statusline.sh"      ;;
    auto) script="$DIR/statusline-auto.sh" ;;
esac

# --- Réécriture atomique de settings.json via jq ---
tmp="$(mktemp "${SETTINGS}.XXXXXX")"
trap 'rm -f "$tmp"' EXIT

if [[ "$target" == "off" ]]; then
    jq 'del(.statusLine)' "$SETTINGS" >"$tmp"
else
    [[ -x "$script" ]] || echo "Note : $script n'est pas exécutable (chmod +x recommandé)." >&2
    jq --arg cmd "$script" --argjson refresh "$REFRESH_S" \
        '.statusLine = ((.statusLine // {}) + {type: "command", command: $cmd})
         | .statusLine.refreshInterval //= $refresh' "$SETTINGS" >"$tmp"
fi

# Garde-fou : ne remplace que si le résultat est un JSON valide et non vide.
if jq -e . "$tmp" >/dev/null 2>&1; then
    mv "$tmp" "$SETTINGS"
    trap - EXIT
    echo "Status line -> $target${script:+  ($script)}"
    echo "Effet au prochain rafraîchissement de la status line."
else
    echo "Échec : le JSON généré est invalide, settings.json non modifié." >&2
    exit 1
fi
